DISTOPIA_APP_URL=https://distopia.arkflame.com
DISTOPIA_PORT=3928
DISTOPIA_DB_PATH=./data/distopia.db
DISTOPIA_UPLOAD_DIR=./data/cdn
DISTOPIA_MAX_UPLOAD_BYTES=8388608
DISTOPIA_MAX_IMAGE_UPLOAD_BYTES=8388608
DISTOPIA_MAX_ZIP_UPLOAD_BYTES=8388608
DISTOPIA_COOKIE_NAME=distopia_session
DISTOPIA_SECURE_COOKIES=auto
OPENROUTER_API_KEY=
DISTOPIA_AI_MODEL=openrouter/free

# Development only: hosts allowed to request Next.js dev/HMR assets when using ./scripts/dev-linux.sh.
DISTOPIA_DEV_ORIGINS=localhost,127.0.0.1,0.0.0.0,192.168.1.2,distopia.arkflame.com
